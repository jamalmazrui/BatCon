; accept.inix -- what "done" means for BatCon, written down before the code is.
;
; MODULE 1 OF THE METHOD IS "SPECIFY BEFORE YOU GENERATE", and this file is
; where that specification lands. Each [check] is one thing that must be true
; for the program to be finished, stated so a script can settle it rather than
; a person having to remember.
;
;   Name    what the check is for, in a few words
;   Run     a command, run in this folder
;   Expect  the exit code it must return; 0 unless you mean otherwise
;   Wants   optional: a string its output must contain
;
; That is the whole language, on purpose. A criterion nobody can read is a
; criterion nobody writes.
;
; check runs every one of these and records the command, the exit code
; and the verdict in the evidence report. A criterion that cannot be written
; this way is still worth writing -- put it in self.md under what a person has
; to check by hand, so it is not quietly forgotten.

FileTask = accept

; The program is built into exec, so each command names exec\BatCon.exe; run
; from the project folder, a bare BatCon.exe is not found (1.43.31).

[check]
Name = the program starts and answers for itself
Run = exec\BatCon.exe /help
Expect = 0
Wants = --source-paths

[check]
Name = a bad switch is refused rather than ignored
Run = exec\BatCon.exe /nonsense
Expect = 1

; THE BUILT PROGRAM DOES THE ACTUAL JOB (24 October 2026, from QUILL's word_selfcheck). QUILL's runtime once
; lacked a library its Word reader needed; every build exited 0 and every installed copy quietly opened Word
; files as plain text, because nothing asked the build to convert anything. These convert BatCon's own guide
; to a Word file, an EPUB and a PDF -- the PDF through Edge -- into logs\accept, which tidy keeps out of git.

[check]
Name = the built program makes a Word file
Run = exec\BatCon.exe help\BatCon.md -t docx -o logs\accept -f
Expect = 0

[check]
Name = the built program makes an EPUB
Run = exec\BatCon.exe help\BatCon.md -t epub -o logs\accept -f
Expect = 0

[check]
Name = the built program makes a PDF
Run = exec\BatCon.exe help\BatCon.md -t pdf -o logs\accept -f
Expect = 0

[check]
Name = a missing source is reported, not crashed on
Run = exec\BatCon.exe /source nothing-here.txt
Expect = 1
